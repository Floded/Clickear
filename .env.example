# Base de datos (docker-compose local)
DATABASE_URL="postgresql://clickear:clickear_dev@localhost:5433/clickear?schema=public"

# Redis (para colas ARCA - Fase 5)
REDIS_URL="redis://localhost:6379"

# Servidor
PORT=3000
NODE_ENV=development

# Auth (JWT)
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN=604800
ALLOWED_ORIGIN="http://localhost:5173"

# Usuario inicial (lo crea prisma/seed.ts)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambiar-contraseña"
ADMIN_NAME="Administrador"

# Supabase Storage (logotipo de empresa, bucket público corporativo)
# Usar la nueva clave secreta de Supabase (sb_secret_...) como SUPABASE_SECRET_KEY.
# Se mantiene compatibilidad con SUPABASE_SERVICE_ROLE_KEY (legacy).
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="company-assets"
SUPABASE_STORAGE_COMPANY_LOGO_PREFIX="company"
